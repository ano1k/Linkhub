# ---------------------------------------------------------------------------
# LinkHub - variables d'environnement
#
# Copie ce fichier en `.env` pour le developpement local, ou renseigne ces
# variables dans les "Environment Variables" de ton hebergeur (Render, Vercel,
# Docker...). Seules les variables marquees OBLIGATOIRE sont necessaires.
# ---------------------------------------------------------------------------

# --- Base de donnees ------------------------------------------------------
# OBLIGATOIRE en production : base Turso (libSQL).
# Cree la base puis : turso db show <nom> --url / turso db tokens create <nom>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Requis par la CLI Prisma (generate / db push / migrate), meme si le runtime
# utilise TURSO_DATABASE_URL. En production, mets la meme valeur que ci-dessus.
# En local, laisse la valeur par defaut : `npm run db:push` cree le fichier.
DATABASE_URL=file:./db/custom.db

# --- Securite -------------------------------------------------------------
# OBLIGATOIRE en production : signe les sessions et chiffre les secrets stockes
# (URL de webhook). 32 caracteres minimum. Generer : openssl rand -hex 32
APP_SECRET=

# URL publique du site, SANS slash final. Sert aux redirections OAuth, aux liens
# renvoyes par l'API, au heartbeat et au sitemap.
# Exemple : https://linkhub.exemple.com
PUBLIC_BASE_URL=

# IDs Discord des membres du staff (acces aux Reglages du site), separes par des
# virgules. Discord > Mode developpeur > clic droit sur ton nom > Copier l'ID.
STAFF_DISCORD_IDS=

# Jeton de premiere installation (recommande des que le site est public).
# Sur une instance neuve, l'OAuth n'est pas encore configure : sans ce jeton,
# le premier venu pourrait enregistrer SA propre application Discord.
# Definis une valeur aleatoire (openssl rand -hex 24) : elle sera demandee une
# seule fois, dans le formulaire de configuration.
SETUP_TOKEN=

# --- Taches planifiees ---------------------------------------------------
# Jeton du cron de rafraichissement (obligatoire en serverless : Vercel, Netlify,
# Lambda...). Generer : openssl rand -hex 24
# Un cron externe appelle POST /api/cron/refresh avec Authorization: Bearer <jeton>
# (ou X-Cron-Secret, ou ?secret=).
# Sans cette variable, la route repond 503 et la boucle interne reste active.
# Doit avoir la MEME valeur que le secret CRON_SECRET du depot GitHub, qui ping
# le site toutes les 5 min (.github/workflows/ping.yml).
CRON_SECRET=

# --- Application Discord (optionnel) -------------------------------------
# Peuvent aussi etre saisis dans le tableau de bord (Reglages) : la valeur en
# base a alors priorite sur ces variables.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Nom affiche dans les notifications Discord (defaut : LinkHub).
SITE_NAME=

# --- Mode demo (developpement uniquement) --------------------------------
# Pointe l'API Discord vers le serveur simule (mini-services/mock-discord).
# NE JAMAIS definir DISCORD_API_BASE en production.
# DISCORD_API_BASE=http://127.0.0.1:3030
# Port du serveur simule (defaut : 3030).
# DISCORD_MOCK_PORT=3030
# Ecran d'autorisation OAuth du serveur simule.
# DISCORD_AUTHORIZE_URL=http://127.0.0.1:3030/oauth2/authorize

# --- Ajustements (optionnel) ---------------------------------------------
# Intervalle de verification des invitations, en millisecondes.
# Defaut : 300000 (5 minutes). En dessous de 60000, le risque de rate limit
# Discord augmente fortement.
# REFRESH_INTERVAL_MS=300000

# Port d'ecoute du serveur Next.js (defaut : 3000).
# PORT=3000
